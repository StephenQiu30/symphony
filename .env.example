# Linear 个人 API Key；如果你已经在 shell 全局 export 了 LINEAR_API_KEY，这里可以留空。
LINEAR_API_KEY=

# Symphony 要轮询的 Linear 项目 slug；从 Linear 项目 URL 中复制最后的 slug 部分。
SYMPHONY_LINEAR_PROJECT_SLUG=

# Symphony 在本机创建每个任务工作区的根目录。
SYMPHONY_WORKSPACE_ROOT=~/code/symphony-workspaces

# 每个 Linear 任务创建 workspace 后要 clone 的目标代码仓库地址；私有仓库推荐使用 SSH 地址。
SOURCE_REPO_URL=https://github.com/openai/symphony

# 每个 workspace clone 后要 checkout 的目标分支；留空时 workflow 默认使用 main。
SYMPHONY_TARGET_BRANCH=main

# Cursor bridge 命令路径。可指向本仓库 scripts/cursor-symphony-bridge，
# 或留空并把 cursor-symphony-bridge 放到 PATH。
SYMPHONY_CURSOR_BRIDGE=

# 可选：限制 Cursor Agent 必须使用指定登录账号；留空则使用当前机器 cursor-agent login 的账号。
SYMPHONY_CURSOR_EXPECTED_ACCOUNT=

# Dashboard 映射到宿主机的端口。
SYMPHONY_PORT=4000

# Docker 启动时，宿主机上用于保存 workspace 的目录。
SYMPHONY_HOST_WORKSPACE_ROOT=./.symphony-workspaces
