#!/usr/bin/env python3
"""
Protocol bridge between Symphony's app-server JSON-RPC stream and Cursor ACP.

The bridge keeps a Cursor ACP subprocess alive for the whole Symphony session,
so Cursor runs match Codex's long-lived app-server execution shape instead of
spawning one short-lived `cursor-agent -p` process per turn.
"""

from __future__ import annotations

import argparse
import json
import os
import shutil
import signal
import subprocess
import sys
import threading
import time
import uuid


BRIDGE_VERSION = "1.0.0"


def log(message: str) -> None:
    sys.stderr.write(f"[cursor-bridge] {message}\n")
    sys.stderr.flush()


def send_symphony(payload: dict) -> None:
    sys.stdout.write(json.dumps(payload, separators=(",", ":")) + "\n")
    sys.stdout.flush()


_session_log = None


def session_log(message: str) -> None:
    global _session_log
    if _session_log is None:
        log_dir = os.path.expanduser("~/.cache/symphony-logs")
        os.makedirs(log_dir, exist_ok=True)
        _session_log = open(os.path.join(log_dir, f"cursor-bridge-{os.getpid()}.log"), "a")

    _session_log.write(f"[{time.strftime('%H:%M:%S')}] {message}\n")
    _session_log.flush()


def find_cursor_binary(explicit_binary: str | None = None) -> str:
    candidates = [explicit_binary] if explicit_binary else []
    candidates.extend([os.environ.get("CURSOR_AGENT_BIN"), "agent", "cursor-agent"])

    for candidate in candidates:
        if not candidate:
            continue
        resolved = shutil.which(candidate)
        if resolved:
            return resolved

    raise RuntimeError("Cursor CLI not found on PATH. Install Cursor CLI or set CURSOR_AGENT_BIN.")


def cursor_status(binary: str) -> str:
    try:
        result = subprocess.run(
            [binary, "status"],
            check=False,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            timeout=20,
        )
    except Exception as exc:
        return f"cursor status failed: {exc}"

    return result.stdout or ""


def assert_expected_account(binary: str) -> None:
    expected = os.environ.get("SYMPHONY_CURSOR_EXPECTED_ACCOUNT", "").strip()
    if not expected:
        return

    status = cursor_status(binary)
    if f"Logged in as {expected}" not in status:
        raise RuntimeError(
            "Cursor CLI is not logged in as "
            f"{expected}. Current status:\n{status.strip()}"
        )


class ACPClient:
    def __init__(self, binary: str, model: str | None = None) -> None:
        self.binary = binary
        self.model = model
        self.process: subprocess.Popen | None = None
        self._alive = False
        self._lock = threading.Lock()
        self._next_id = 1
        self._pending: dict[int, dict] = {}
        self._reader_thread: threading.Thread | None = None

    @property
    def is_alive(self) -> bool:
        return self._alive and self.process is not None and self.process.poll() is None

    def start(self) -> None:
        cmd = [self.binary]

        api_key = os.environ.get("CURSOR_API_KEY")
        if api_key:
            cmd.extend(["--api-key", api_key])

        if self.model:
            cmd.extend(["--model", self.model])

        cmd.append("acp")

        self.process = subprocess.Popen(
            cmd,
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            bufsize=1,
        )
        self._alive = True
        self._reader_thread = threading.Thread(target=self._read_loop, daemon=True)
        self._reader_thread.start()
        session_log(f"[ACP] started pid={self.process.pid} binary={self.binary}")

    def stop(self) -> None:
        self._alive = False
        if self.process and self.process.poll() is None:
            try:
                self.process.terminate()
                self.process.wait(timeout=5)
            except Exception:
                try:
                    self.process.kill()
                except Exception:
                    pass

    def initialize(self) -> dict:
        return self._request(
            "initialize",
            {
                "protocolVersion": 1,
                "clientCapabilities": {
                    "fs": {"readTextFile": False, "writeTextFile": False},
                    "terminal": False,
                },
                "clientInfo": {
                    "name": "symphony-cursor-bridge",
                    "title": "Symphony Cursor Bridge",
                    "version": BRIDGE_VERSION,
                },
            },
        )

    def authenticate(self) -> dict:
        return self._request("authenticate", {"methodId": "cursor_login"})

    def new_session(self, cwd: str) -> str:
        result = self._request("session/new", {"cwd": cwd, "mcpServers": []}, timeout=120)
        session_id = result.get("sessionId") if isinstance(result, dict) else None
        if not session_id:
            raise RuntimeError(f"session/new did not return sessionId: {result!r}")
        return session_id

    def prompt(self, session_id: str, prompt: str, timeout: int) -> dict:
        return self._request(
            "session/prompt",
            {"sessionId": session_id, "prompt": [{"type": "text", "text": prompt}]},
            timeout=timeout,
        )

    def _request(self, method: str, params: dict, timeout: int = 60) -> dict:
        if not self.is_alive:
            raise RuntimeError("Cursor ACP process is not running")

        request_id = self._allocate_id()
        entry = {"event": threading.Event(), "result": None, "error": None}

        with self._lock:
            self._pending[request_id] = entry

        self._write({"jsonrpc": "2.0", "id": request_id, "method": method, "params": params})

        if not entry["event"].wait(timeout=timeout):
            with self._lock:
                self._pending.pop(request_id, None)
            raise RuntimeError(f"timeout waiting for Cursor ACP response to {method}")

        with self._lock:
            self._pending.pop(request_id, None)

        if entry["error"] is not None:
            raise RuntimeError(f"Cursor ACP error for {method}: {entry['error']!r}")

        result = entry["result"]
        return result if isinstance(result, dict) else {}

    def _allocate_id(self) -> int:
        with self._lock:
            request_id = self._next_id
            self._next_id += 1
            return request_id

    def _write(self, payload: dict) -> None:
        if not self.process or not self.process.stdin:
            raise RuntimeError("Cursor ACP stdin is not available")

        self.process.stdin.write(json.dumps(payload, separators=(",", ":")) + "\n")
        self.process.stdin.flush()

    def _read_loop(self) -> None:
        assert self.process is not None
        assert self.process.stdout is not None

        try:
            for raw_line in self.process.stdout:
                line = raw_line.strip()
                if not line:
                    continue
                try:
                    message = json.loads(line)
                except json.JSONDecodeError:
                    log(f"non-JSON from Cursor ACP: {line[:200]}")
                    continue
                self._dispatch(message)
        except Exception as exc:
            log(f"Cursor ACP reader failed: {exc}")
        finally:
            self._alive = False
            with self._lock:
                for entry in self._pending.values():
                    if entry["error"] is None and entry["result"] is None:
                        entry["error"] = "Cursor ACP process exited"
                    entry["event"].set()

    def _dispatch(self, message: dict) -> None:
        message_id = message.get("id")
        if message_id is not None and ("result" in message or "error" in message):
            with self._lock:
                entry = self._pending.get(message_id)
            if entry:
                entry["error"] = message.get("error")
                entry["result"] = message.get("result", {})
                entry["event"].set()
            return

        method = message.get("method")
        if method == "session/request_permission" and message_id is not None:
            session_log(f"[PERMISSION] auto-approved {json.dumps(message.get('params', {}), ensure_ascii=False)[:500]}")
            self._write(
                {
                    "jsonrpc": "2.0",
                    "id": message_id,
                    "result": {"outcome": {"outcome": "selected", "optionId": "allow-always"}},
                }
            )
            return

        if method == "session/update":
            self._log_update(message)
            return

        if method and method.startswith("cursor/") and message_id is not None:
            self._write({"jsonrpc": "2.0", "id": message_id, "result": {}})
            return

        if method and message_id is not None:
            session_log(f"[ACP] unhandled request method={method}")
            self._write({"jsonrpc": "2.0", "id": message_id, "result": {}})

    def _log_update(self, message: dict) -> None:
        params = message.get("params", {})
        update = params.get("update", {}) if isinstance(params, dict) else {}
        kind = update.get("sessionUpdate", "") if isinstance(update, dict) else ""

        if kind == "agent_message_chunk":
            content = update.get("content", {})
            text = content.get("text", "") if isinstance(content, dict) else ""
            if text:
                session_log(f"[AGENT] {text[:1000]}")
        elif kind == "tool_call":
            session_log(f"[TOOL] {update.get('title', '')} {update.get('status', '')}")
        elif kind:
            session_log(f"[{kind}] {json.dumps(update, ensure_ascii=False, default=str)[:500]}")


class Bridge:
    def __init__(self, binary: str, model: str | None = None, timeout: int = 3600) -> None:
        self.binary = binary
        self.model = model
        self.timeout = timeout
        self.acp = ACPClient(binary, model)
        self.thread_sessions: dict[str, str] = {}

    def start(self) -> None:
        self.acp.start()
        init_result = self.acp.initialize()
        session_log(f"[INIT] {json.dumps(init_result, ensure_ascii=False, default=str)[:500]}")
        try:
            auth_result = self.acp.authenticate()
            session_log(f"[AUTH] {json.dumps(auth_result, ensure_ascii=False, default=str)[:500]}")
        except Exception as exc:
            session_log(f"[AUTH] non-fatal authenticate failure: {exc}")

    def stop(self) -> None:
        self.acp.stop()

    def run(self) -> None:
        for raw_line in sys.stdin:
            line = raw_line.strip()
            if not line:
                continue

            try:
                message = json.loads(line)
            except json.JSONDecodeError:
                continue

            method = message.get("method")
            if method == "initialize":
                send_symphony({"id": message["id"], "result": {}})
            elif method == "initialized":
                continue
            elif method == "thread/start":
                self.handle_thread_start(message)
            elif method == "turn/start":
                self.handle_turn_start(message)
            elif "id" in message:
                send_symphony(
                    {
                        "id": message["id"],
                        "error": {"code": -32601, "message": f"Method not found: {method}"},
                    }
                )

    def handle_thread_start(self, message: dict) -> None:
        params = message.get("params", {})
        cwd = params.get("cwd") or os.getcwd()

        try:
            session_id = self.acp.new_session(cwd)
        except Exception as exc:
            send_symphony(
                {
                    "id": message["id"],
                    "error": {"code": -32000, "message": f"Failed to create Cursor session: {exc}"},
                }
            )
            return

        thread_id = f"cursor-thread-{uuid.uuid4().hex[:12]}"
        self.thread_sessions[thread_id] = session_id
        session_log(f"[SESSION] thread={thread_id} cursor_session={session_id} cwd={cwd}")
        send_symphony({"id": message["id"], "result": {"thread": {"id": thread_id}}})

    def handle_turn_start(self, message: dict) -> None:
        params = message.get("params", {})
        thread_id = params.get("threadId")
        turn_id = f"cursor-turn-{uuid.uuid4().hex[:12]}"
        prompt = self._prompt_text(params.get("input", []))
        session_id = self.thread_sessions.get(thread_id)

        if not session_id:
            send_symphony({"id": message["id"], "result": {"turn": {"id": turn_id}}})
            send_symphony({"method": "turn/failed", "params": {"error": "missing Cursor ACP session for thread"}})
            return

        send_symphony({"id": message["id"], "result": {"turn": {"id": turn_id}}})
        session_log(f"[TURN] start turn={turn_id} thread={thread_id} prompt_chars={len(prompt)}")

        try:
            if not self.acp.is_alive:
                self.restart_acp()
                session_id = self._recreate_thread_session(thread_id, params.get("cwd") or os.getcwd())

            result = self.acp.prompt(session_id, prompt, timeout=self.timeout)
            stop_reason = result.get("stopReason", "") if isinstance(result, dict) else ""
            session_log(f"[TURN] complete turn={turn_id} stopReason={stop_reason}")

            usage = result.get("usage") if isinstance(result, dict) else None
            payload = {"method": "turn/completed"}
            if isinstance(usage, dict):
                payload["usage"] = usage
            send_symphony(payload)
        except Exception as exc:
            session_log(f"[TURN] failed turn={turn_id}: {exc}")
            send_symphony({"method": "turn/failed", "params": {"error": f"Cursor ACP prompt failed: {exc}"}})

    def restart_acp(self) -> None:
        self.acp.stop()
        self.acp = ACPClient(self.binary, self.model)
        self.acp.start()
        self.acp.initialize()
        try:
            self.acp.authenticate()
        except Exception as exc:
            session_log(f"[AUTH] non-fatal authenticate failure after restart: {exc}")

    def _recreate_thread_session(self, thread_id: str | None, cwd: str) -> str:
        session_id = self.acp.new_session(cwd)
        if thread_id:
            self.thread_sessions[thread_id] = session_id
        return session_id

    @staticmethod
    def _prompt_text(items: list) -> str:
        parts = []
        for item in items:
            if isinstance(item, dict) and item.get("type") == "text":
                parts.append(item.get("text", ""))
        return "".join(parts)


def main() -> None:
    parser = argparse.ArgumentParser(description="Symphony Cursor ACP bridge")
    parser.add_argument("--model", default=os.environ.get("CURSOR_MODEL"))
    parser.add_argument("--agent-bin", default=None, help="Cursor CLI binary, defaults to CURSOR_AGENT_BIN, agent, then cursor-agent")
    parser.add_argument("--turn-timeout", type=int, default=int(os.environ.get("CURSOR_TURN_TIMEOUT_SECONDS", "3600")))
    parser.add_argument("--version", action="store_true")
    args = parser.parse_args()

    try:
        binary = find_cursor_binary(args.agent_bin)
    except Exception as exc:
        log(str(exc))
        sys.exit(127)

    if args.version:
        print(f"cursor-symphony-bridge {BRIDGE_VERSION}")
        print(cursor_status(binary).strip())
        return

    try:
        assert_expected_account(binary)
    except Exception as exc:
        log(str(exc))
        sys.exit(1)

    bridge = Bridge(binary, args.model, args.turn_timeout)

    def shutdown(_signum, _frame) -> None:
        bridge.stop()
        sys.exit(0)

    signal.signal(signal.SIGTERM, shutdown)

    try:
        bridge.start()
        bridge.run()
    except KeyboardInterrupt:
        pass
    except Exception as exc:
        log(f"fatal bridge failure: {exc}")
        sys.exit(1)
    finally:
        bridge.stop()


if __name__ == "__main__":
    main()
