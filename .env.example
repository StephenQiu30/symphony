# Linear 个人 API Key；如果你已经在 shell 全局 export 了 LINEAR_API_KEY，这里可以留空。
LINEAR_API_KEY=
# Symphony 要轮询的 Linear 项目 slug；从 Linear 项目 URL 中复制最后的 slug 部分。
SYMPHONY_LINEAR_PROJECT_SLUG=
# Symphony 在本机创建每个任务工作区的根目录。
SYMPHONY_WORKSPACE_ROOT=~/code/symphony-workspaces
# 每个 Linear 任务创建 workspace 后要 clone 的目标代码仓库地址；私有仓库推荐使用 SSH 地址。
SOURCE_REPO_URL=https://github.com/StephenQiu30/symphony.git
# Dashboard 映射到宿主机的端口。
SYMPHONY_PORT=4000
# Docker 启动时，宿主机上用于保存 workspace 的目录。
SYMPHONY_HOST_WORKSPACE_ROOT=./.symphony-workspaces

# Optional: Antigravity Agent API bridge.
# Symphony's `gemini.command` uses the Gemini CLI stream-json protocol by default.
# Antigravity is a separate local agent service; it is not enabled by placing
# files under ~/.gemini/antigravity. Only set these after Antigravity's LS is
# healthy and `agentapi new-conversation` works from the same shell.
#
# Find the current gRPC LS port from:
#   lsof -nP -p $(pgrep -f 'antigravity.*/language_server' | head -1) -iTCP -sTCP:LISTEN
# Then verify:
#   ANTIGRAVITY_LS_ADDRESS=127.0.0.1:<grpc-port> \
#     ~/.gemini/antigravity/bin/agentapi new-conversation --model=flash "health check"
#
# Leave blank to use Gemini CLI OAuth/API-key auth instead.
ANTIGRAVITY_LS_ADDRESS=
ANTIGRAVITY_AGENTAPI=~/.gemini/antigravity/bin/agentapi
